#!/usr/bin/env python3
"""The narrow broker behind the voice assistant's actions.

The agent CLI is never granted a shell or a tool. When actions are enabled,
the daemon parses one strictly validated <<jarvis:open-...>> directive out of
the agent's reply text and execs this script directly -- a single argv, no
shell anywhere in the path. That makes this script the entire blast radius:
it can launch an installed desktop app or open an http(s) URL, and nothing
else, and it re-validates its arguments itself rather than trusting the
caller's.

    jarvis-open list            every launchable app name
    jarvis-open app <name>      launch one
    jarvis-open url <https://…> open a web page
    jarvis-open bookmark <name> open a bookmark from Chromium's default profile
    jarvis-open workspace <n>   switch to a workspace
    jarvis-open theme <name>    set the Omarchy theme
    jarvis-open themes          every installed theme name
    jarvis-open volume <what>   up | down | mute | 0-100
    jarvis-open brightness <w>  up | down | 0-100

It used to be a shell script that ran `grep` over every path matching
$HOME/.local/share/applications/*.desktop and buffered the whole generated
entry list. Both halves of that trusted the filesystem: a `.desktop` name
planted as a FIFO makes grep wait for a writer that never comes -- hanging
the agent call, and with it the assistant -- and a large or endless file is
read into memory whole. Reading is done here instead, descriptor-first
through safefile: never blocking, regular files only, bounded per file and
bounded in total.
"""

import json
import os
import re
import subprocess
import sys
import urllib.parse

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import safefile  # noqa: E402  (needs our own directory on the path first)

HOME = os.path.expanduser("~")
DATA_HOME = os.environ.get("XDG_DATA_HOME") or os.path.join(HOME, ".local", "share")
APP_DIRS = [os.path.join(DATA_HOME, "applications"), "/usr/share/applications"]

# A .desktop entry is a small ini file; the largest on a normal system is a
# few KB. 64 KiB is room to spare, and everything past it is not an entry we
# need to read to answer "what apps are installed".
MAX_ENTRY_BYTES = 64 << 10
# Nothing to do with what a desktop looks like -- a ceiling so a directory
# stuffed with files cannot make this process grow without bound.
MAX_ENTRIES = 4000

# /usr/share/applications is root-owned and ~/.local/share/applications is
# ours. Anything owned by a third uid is not a package's entry or one we
# wrote, so it does not get read.
OWNERS = {os.geteuid(), 0}

# Chromium keeps bookmarks as one JSON file per profile. Only the default
# profile is read: choosing a profile would mean taking a path from something
# someone said out loud, and not doing that is this script's entire job.
CONFIG_HOME = os.environ.get("XDG_CONFIG_HOME") or os.path.join(HOME, ".config")
BOOKMARKS_PATH = os.path.join(CONFIG_HOME, "chromium", "Default", "Bookmarks")
# A heavily used profile holds a few thousand bookmarks in a few hundred KB.
# The ceiling is here so a huge or endless file fails instead of being read.
MAX_BOOKMARKS_BYTES = 4 << 20
MAX_BOOKMARKS = 5000
# Bookmark folders nest; nothing legitimate nests this deep, and a file that
# claims to is not one we need to finish reading.
MAX_BOOKMARK_DEPTH = 32

NAME_RE = re.compile(r"^Name\s*=\s*(.*)$")
NODISPLAY_RE = re.compile(r"^NoDisplay\s*=\s*(.*)$")
URL_RE = re.compile(r"^https?://[^\s\"'\\]+$")


def read_entry(path):
    """(name, hidden) for one .desktop file, or None if it is unreadable.

    A symlinked .desktop is a normal thing to have, so those are followed --
    but the descriptor still has to turn out to be a regular file of an
    expected owner, within the size ceiling, and the open never blocks.
    """
    try:
        text = safefile.read_text(path, MAX_ENTRY_BYTES,
                                  allow_symlink=True, owners=OWNERS)
    except (OSError, ValueError):
        return None

    name = hidden = None
    for line in text.splitlines():
        if name is None:
            match = NAME_RE.match(line)
            if match:
                name = match.group(1).strip()
                continue
        if hidden is None:
            match = NODISPLAY_RE.match(line)
            if match:
                hidden = match.group(1).strip().lower() == "true"
        if name is not None and hidden is not None:
            break
    return name, bool(hidden)


def entries():
    """Every installed .desktop entry as (id, name), minus the hidden ones.

    First directory wins on a duplicate id, so a user's own override of a
    packaged entry is the one that shows up.
    """
    found = {}
    for directory in APP_DIRS:
        try:
            names = sorted(os.listdir(directory))
        except OSError:
            continue
        for filename in names:
            if not filename.endswith(".desktop"):
                continue
            entry_id = filename[: -len(".desktop")]
            if entry_id in found:
                continue
            # An entry named "--version.desktop" would reach gtk-launch as an
            # option rather than an app. Nothing legitimate is named this way.
            if entry_id.startswith("-"):
                continue
            if len(found) >= MAX_ENTRIES:
                return sorted(found.items())
            parsed = read_entry(os.path.join(directory, filename))
            if parsed is None:
                continue
            name, hidden = parsed
            if hidden:
                continue
            found[entry_id] = name or entry_id
    return sorted(found.items())


def resolve(query):
    """Exact id, then exact name, then substring on either. First hit wins."""
    query = query.lower()
    all_entries = entries()
    for entry_id, name in all_entries:
        if query in (entry_id.lower(), name.lower()):
            return entry_id
    for entry_id, name in all_entries:
        if query in entry_id.lower() or query in name.lower():
            return entry_id
    return None


def bookmarks():
    """[(title, url)] from the default Chromium profile. Never raises.

    Read descriptor-first and bounded, for the same reasons the .desktop
    reader is: this file belongs to another program, and a path that turns
    out to be a FIFO must not hang the assistant while an agent call waits.

    Only http and https survive the walk. A bookmark can hold a javascript:,
    file: or chrome: URL, and handing one of those to xdg-open because a
    sentence near a microphone asked for it is exactly the hole this broker
    exists not to have.
    """
    try:
        raw = safefile.read_text(BOOKMARKS_PATH, limit=MAX_BOOKMARKS_BYTES,
                                 owners={os.geteuid()})
    except Exception:
        return []
    try:
        data = json.loads(raw)
    except ValueError:
        return []
    found = []

    def walk(node, depth):
        if len(found) >= MAX_BOOKMARKS or depth > MAX_BOOKMARK_DEPTH:
            return
        if not isinstance(node, dict):
            return
        if node.get("type") == "url":
            title, url = node.get("name"), node.get("url")
            if isinstance(title, str) and isinstance(url, str) \
                    and URL_RE.match(url):
                found.append((title.strip(), url))
            return
        children = node.get("children")
        if isinstance(children, list):
            for child in children:
                walk(child, depth + 1)

    roots = data.get("roots")
    if isinstance(roots, dict):
        for root in roots.values():
            walk(root, 0)
    return found


def resolve_bookmark(query):
    """(title, url) for the closest bookmark, or None.

    Exact title first, then a substring of the title, then the site's host,
    so "github" finds a bookmark titled something else entirely. Only the
    host: matching anywhere in the URL would let a query hit a word buried in
    a query string, which is not something anyone asked to open.
    """
    query = " ".join(query.lower().split())
    if not query:
        return None
    found = bookmarks()
    for title, url in found:
        if query == title.lower():
            return title, url
    for title, url in found:
        if query in title.lower():
            return title, url
    for title, url in found:
        if query in (urllib.parse.urlsplit(url).hostname or "").lower():
            return title, url
    return None


def origin_of(url):
    """scheme://host[:port], the part of a URL that is safe to print.

    Built from hostname and port rather than netloc, which would carry any
    user:password@ into whatever journals our output.
    """
    parts = urllib.parse.urlsplit(url)
    try:
        host, port = parts.hostname or "", parts.port
    except ValueError:
        host, port = parts.hostname or "", None
    return f"{parts.scheme}://{host}" + (f":{port}" if port else "")


# --------------------------------------------------------------------------
# Desktop controls
#
# Every one of these is a fixed argument list with the value substituted into
# a single slot, and every value is checked against an enum or a number range
# before it gets there. Nothing the speaker says becomes part of a command
# name, a flag, or a path: the worst a bad value can do is fail this check.
#
# They were chosen for being reversible. Changing a workspace, a theme, the
# volume or the brightness is undone by saying the opposite, and none of them
# touches a file, installs anything, or reaches the network.
# --------------------------------------------------------------------------

# Hyprland's named workspaces go past 10, but a spoken number that large is
# far more likely to be a misheard year than a workspace someone uses.
WORKSPACE_RE = re.compile(r"^(?:[1-9]|10)$")
LEVEL_RE = re.compile(r"^(?:100|[1-9]?[0-9])$")
DIRECTIONS = ("up", "down")


def theme_names():
    """Installed Omarchy theme names, or [] if the lister is unavailable."""
    try:
        proc = subprocess.run(["omarchy-theme-list"], capture_output=True,
                              text=True, timeout=10, check=False)
    except (OSError, subprocess.SubprocessError):
        return []
    if proc.returncode != 0:
        return []
    return [line.strip() for line in proc.stdout.splitlines() if line.strip()]


def resolve_theme(query):
    """The closest installed theme name, or None.

    Matched the way an app is: against names this script read itself, so the
    value handed to omarchy-theme-set is always one that already existed.
    """
    query = " ".join(query.lower().split())
    if not query:
        return None
    names = theme_names()
    for name in names:
        if query == name.lower():
            return name
    for name in names:
        if query in name.lower():
            return name
    return None


def run_desktop(command, value):
    """One desktop control.

    Returns (attempts, spoken_result), where attempts is a list of argument
    lists to try in order until one succeeds, or None if the value is not one
    this control accepts.

    More than one attempt exists because Hyprland changed how `hyprctl
    dispatch` parses its arguments: current versions read a Lua expression
    and older ones read a dispatcher name followed by words. Neither form
    works on the other, and a plugin someone installs has no say in which
    version they run, so both are tried.
    """
    if command == "workspace":
        if not WORKSPACE_RE.match(value):
            return None
        # value is digits only, checked directly above, so it cannot carry
        # anything into the Lua string but the number it is.
        return ([["hyprctl", "dispatch",
                  'hl.dsp.focus({workspace="%s"})' % value],
                 ["hyprctl", "dispatch", "workspace", value]],
                f"workspace {value}")

    if command == "theme":
        name = resolve_theme(value)
        if name is None:
            return None
        return [["omarchy-theme-set", name]], f"theme {name}"

    if command == "volume":
        if value == "mute":
            return ([["omarchy-audio-output-volume", "mute-toggle"]],
                    "mute toggled")
        if value in DIRECTIONS:
            action = "raise" if value == "up" else "lower"
            return ([["omarchy-audio-output-volume", action]], f"volume {value}")
        if LEVEL_RE.match(value):
            # omarchy's volume command is relative only, so an absolute level
            # goes through wpctl. Still one fixed argv with a checked number.
            return ([["wpctl", "set-volume", "@DEFAULT_AUDIO_SINK@",
                      value + "%"]], f"volume {value}%")
        return None

    if command == "brightness":
        if value in DIRECTIONS:
            step = "+10%" if value == "up" else "10%-"
            return ([["omarchy-brightness-display", step]],
                    f"brightness {value}")
        if LEVEL_RE.match(value):
            return ([["omarchy-brightness-display", value + "%"]],
                    f"brightness {value}%")
        return None

    return None


def spawn(argv):
    """Detach, so the app outlives this script and the daemon's timeout."""
    subprocess.Popen(argv, start_new_session=True,
                     stdin=subprocess.DEVNULL,
                     stdout=subprocess.DEVNULL,
                     stderr=subprocess.DEVNULL)


def have(command):
    for directory in os.environ.get("PATH", "").split(os.pathsep):
        if directory and os.access(os.path.join(directory, command), os.X_OK):
            return True
    return False


def launch(entry_id):
    desktop = entry_id + ".desktop"
    # Under uwsm the app belongs in its own systemd scope; elsewhere
    # gtk-launch is what actually knows how to run a .desktop entry.
    if have("uwsm") and os.environ.get("UWSM_WAIT_VARNAMES"):
        spawn(["uwsm", "app", "--", desktop])
    elif have("gtk-launch"):
        spawn(["gtk-launch", "--", desktop])
    else:
        raise SystemExit("no way to launch a .desktop entry "
                         "(install uwsm or gtk-launch)")


def usage():
    print("usage: jarvis-open list | app <name> | url <https://...> "
          "| bookmark <name> | themes | workspace <n> | theme <name> "
          "| volume <up|down|mute|0-100> | brightness <up|down|0-100>",
          file=sys.stderr)
    return 2


def main(argv):
    if not argv:
        return usage()
    command, rest = argv[0], argv[1:]

    if command == "list":
        for _, name in entries():
            print(name)
        return 0

    if command == "app":
        if not rest:
            return usage()
        query = " ".join(rest)
        entry_id = resolve(query)
        if entry_id is None:
            print(f"no installed app matches '{query}'", file=sys.stderr)
            return 1
        launch(entry_id)
        print(f"launched {entry_id}")
        return 0

    if command == "themes":
        for name in theme_names():
            print(name)
        return 0

    if command in ("workspace", "theme", "volume", "brightness"):
        if not rest:
            return usage()
        value = " ".join(rest)
        resolved = run_desktop(command, value)
        if resolved is None:
            print(f"refusing '{command} {value}'", file=sys.stderr)
            return 1
        attempts, said = resolved
        if not have(attempts[0][0]):
            print(f"{attempts[0][0]} is not installed", file=sys.stderr)
            return 1
        # Waited on, unlike launching an app. These finish in moments, and a
        # caller that does not check has no way to tell a change that happened
        # from one that failed: `hyprctl dispatch` exits 7 on a syntax it no
        # longer accepts, and reporting that as done is how the assistant ends
        # up saying "switching to workspace two" while nothing moves.
        last = None
        for argv_out in attempts:
            try:
                last = subprocess.run(argv_out, capture_output=True, text=True,
                                      timeout=15, check=False)
            except (OSError, subprocess.SubprocessError) as exc:
                print(f"{argv_out[0]} did not run: {exc}", file=sys.stderr)
                return 1
            if last.returncode == 0:
                print(f"set {said}")
                return 0
        detail = (last.stderr or last.stdout or "").strip().splitlines()
        print(f"{attempts[0][0]} refused: {detail[0] if detail else 'no reason given'}",
              file=sys.stderr)
        return 1

    if command == "bookmark":
        if not rest:
            return usage()
        query = " ".join(rest)
        hit = resolve_bookmark(query)
        if hit is None:
            print(f"no bookmark matches '{query}'", file=sys.stderr)
            return 1
        _, url = hit
        # Checked in bookmarks() already. Checked again because this is the
        # line that hands a string to the browser.
        if not URL_RE.match(url):
            print("refusing non-http(s) url", file=sys.stderr)
            return 1
        spawn(["xdg-open", url])
        # The caller journals this line. A bookmark title is the speaker's
        # own business, so it says where it went and not what it was called.
        print(f"opened {origin_of(url)}")
        return 0

    if command == "url":
        if len(rest) != 1:
            return usage()
        url = rest[0]
        # Only ever hand a real web URL to the browser.
        if not URL_RE.match(url):
            print("refusing non-http(s) url", file=sys.stderr)
            return 1
        spawn(["xdg-open", url])
        print(f"opened {url}")
        return 0

    return usage()


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
