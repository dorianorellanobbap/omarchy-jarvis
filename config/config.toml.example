# Jarvis configuration. Copy to ~/.config/jarvis/config.toml and edit.
# Every value here is a default -- delete anything you don't want to change.

# Which agent below answers. Must match an [agents.*] section.
agent = "claude"

# Wake word. These four ship with openWakeWord; no download needed:
#   hey_jarvis  alexa  hey_mycroft  hey_marvin
wake_word = "hey_jarvis"

# Piper voice file, relative to ~/.local/share/jarvis/voices/ or absolute.
voice = "en_US-amy-medium.onnx"

# Write what you said, and the reply, to the journal. Off by default: words
# spoken near an open microphone can carry secrets, and journald persists
# them. When false the journal records sizes and outcomes, never the words.
log_transcripts = false


[listen]
wake_threshold = 0.5   # openWakeWord score 0-1. Lower = more sensitive.
silence_tail   = 1.2   # seconds of quiet that ends your command
min_speech     = 0.4   # ignore blips shorter than this
max_command    = 15.0  # hard cap on one utterance
cooldown       = 1.0   # ignore the wake word this long after replying


# ---------------------------------------------------------------------------
# Agents
#
# `command` is argv, never a shell string. These placeholders are substituted
# into individual arguments:
#
#   {system}   the voice-style system prompt Jarvis builds
#   {outfile}  a temp file path. If present, Jarvis reads the reply from that
#              file instead of stdout -- for CLIs that print progress logs.
#   {prompt}   what you said, transcribed. Leave it out (both presets do):
#              the transcript is then fed to the CLI on stdin, where it does
#              not show up in the process list the way argv does for every
#              local process. A command naming neither {prompt} nor {system}
#              gets both on stdin, system prompt first.
#
# `actions = true` lets the agent launch apps and open URLs through the
# `jarvis-open` wrapper. It only works if the CLI can be told to permit
# exactly one command. Left false, the agent can only answer out loud.
#
# It ships false. Turning it on means a sentence spoken near the microphone
# reaches an agent that has a tool enabled, and what keeps that agent to
# `jarvis-open` alone is the agent CLI's own allowlist enforcement, not
# anything Jarvis can enforce itself. That is a fine trade to make on
# purpose. It is not one to inherit from a default.
#
# Both presets below are tested. Adding another CLI is just another section --
# run `jarvis-listen --agents` to see what's configured and installed, and
# `jarvis-listen --ask "hello"` to try one without using the mic. If you get a
# new one working, a PR adding it is welcome.
# ---------------------------------------------------------------------------

[agents.claude]
# Claude Code. `claude -p` with no prompt argument reads the prompt from
# stdin. Starts with every tool disabled, so --allowedTools grants exactly
# one command and nothing else.
command = [
  "claude", "-p",
  "--append-system-prompt", "{system}",
  "--allowedTools", "Bash(jarvis-open:*)",
]
# Set true to let Jarvis open apps and web pages. Read the note above first.
actions = false

[agents.codex]
# OpenAI Codex in its read-only sandbox. The trailing "-" makes `codex exec`
# read the prompt from stdin; the system prompt rides along there too, since
# codex has no system-prompt flag. -o gives us the reply without the event
# log.
command = [
  "codex", "exec", "--skip-git-repo-check", "--ephemeral",
  "-s", "read-only", "--color", "never",
  "-o", "{outfile}",
  "-",
]
actions = false
